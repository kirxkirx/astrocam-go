# astrocam-go settings
#
# Copy this file to config.env in the folder of the program and fill it in.
# Save it as plain text (ANSI, or UTF-8 without BOM). astrocam-go reads it
# only when it starts: restart it after a change. Everything after a # is a
# comment, so no value - not even a password - can contain a #. Do not put
# quotes around values: they would become part of the value.

# --- Upload server ------------------------------------------------------------

# The address of the upload script, from whoever runs the server. It has to be
# the final address: an upload cannot follow a redirect, so if the server
# redirects http:// to https://, give the https:// address here.
SAI_SERVER=https://your-server.com/cgi-bin/unmw/upload.py

# The login for the upload server. Set both, or leave both empty if the server
# needs no login: with only one of them set, no login is sent.
SAI_USERNAME=your_username
SAI_PASSWORD=your_password

# Optional second upload address, used only while SAI_SERVER does not answer
# at all (its network is down, or it is switched off). A server that answers,
# even with an error (busy, out of disk space, login refused), is waited for
# instead. It uses the same login, and it has to be set up for your camera and
# fields like the main server.
SAI_FALLBACK_SERVER=

# --- Images -------------------------------------------------------------------

# The folder the imaging software saves the images in, as a full path. Only
# files directly in it are read, not subfolders. If the path has a date folder
# with a folder below it, like NINA's ...\2026-11-22\LIGHT, the same folder of
# every other date beside it is watched too, including dates still to come:
# give tonight's folder once and never edit it again.
SAI_CAMERA_DIRECTORY=C:\Users\observer\Documents\N.I.N.A\2026-11-22\LIGHT
# On Linux, for example:
# SAI_CAMERA_DIRECTORY=/home/observer/images/2026-11-22/LIGHT

# Where the original images go once they are packed, as a full path. They are
# moved there; to a folder on another drive they are copied, and each original
# is deleted from the camera folder only once its copy is complete. It must not
# be the camera folder itself. Nothing is ever deleted from it: it grows by
# every night's images, so clear it out regularly.
# If left empty, a "processed" folder next to the program is used.
SAI_PROCESSED_DIRECTORY=C:\AstroCam\processed
# On Linux, for example:
# SAI_PROCESSED_DIRECTORY=/home/observer/images/processed

# How many images the telescope takes of a field in one visit. Every archive
# holds exactly this many images of one field, each taken no more than 10
# minutes after the one before. At least 2.
SAI_COUNT=3

# --- Archive names ------------------------------------------------------------
# Archives are named <date>_<SAI_PREFIX><field>_<time><SAI_POSTFIX>

# Your camera tag with a _ in front of it, for example _TTUQ1b1x1, as agreed
# with whoever runs the server. The server picks your camera's darks, flats
# and settings by it and puts the results on your camera's list of
# candidates. Never use the tag of another camera: your images would then be
# treated as that camera's. While a new setup is tried out, add _test to the
# tag (_TTUQ1b1x1_test): the server then sends no alerts about these uploads
# and keeps them off the candidate lists.
SAI_POSTFIX=_YOUR-CAMERA-TAG

# Text in front of the field name. Use CI_ unless whoever runs the server says
# otherwise: the source monitoring of the unmw server looks for
# <date>_CI_<field>_ in archive names, and the NMW-TexasTech cameras all use it.
SAI_PREFIX=CI_

# --- Timing -------------------------------------------------------------------

# Seconds between two looks at the camera folder. At least 15.
SAI_INTERVAL=15
