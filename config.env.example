# AstroCam Configuration Template
# Copy this file to config.env and fill in your actual values

# Server Configuration
# SAI_SERVER must be the final address of the upload script. An upload cannot
# follow a redirect: if the server redirects http:// to https://, give the
# https:// address here.
# SAI_USERNAME and SAI_PASSWORD may be empty if server does not require them
SAI_SERVER=https://your-server.com/cgi-bin/upload.py
SAI_USERNAME=your_username
SAI_PASSWORD=your_password

# Optional fallback server. If SAI_SERVER is unreachable (network error, not a
# server-side rejection like "out of disk space" or "high load"), the archive is
# uploaded here instead. Leave empty to disable. Uses the same SAI_USERNAME /
# SAI_PASSWORD as the primary server.
SAI_FALLBACK_SERVER=

# Directory Configuration
# Windows example:
# SAI_CAMERA_DIRECTORY=C:\CCD_NMW\1_semka\
# SAI_PROCESSED_DIRECTORY=C:\CCD_NMW\2_otpravleno\

# Linux example:
SAI_CAMERA_DIRECTORY=/home/user/camera/input
SAI_PROCESSED_DIRECTORY=/home/user/camera/processed

# NINA date-folder auto-detection:
# If SAI_CAMERA_DIRECTORY ends with .../YYYY-MM-DD/LIGHT (NINA's default output
# layout), astrocam-go also scans the folder for the current NINA night, whose
# date is (now - 12 hours). This is recomputed every scan cycle, so the folder
# name rolls over automatically and you do not need to edit the date each night.
# The configured directory is always scanned as well, and a not-yet-created NINA
# folder is simply picked up as soon as it appears (astrocam-go may be started
# before NINA creates it). No configuration is needed to enable this.

# Processing Configuration
SAI_INTERVAL=10          # Scan interval in seconds (minimum 15)
SAI_COUNT=3              # Number of files per archive
SAI_PREFIX=              # Optional prefix for archive names
SAI_POSTFIX=_STL-11000M  # Optional postfix for archive names

